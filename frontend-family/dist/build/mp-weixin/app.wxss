page{min-height:100%;background:#f5f5f5;color:#1f2329;font-family:-apple-system,BlinkMacSystemFont,PingFang SC,Microsoft YaHei,sans-serif;font-size:28rpx}view,text,image,input,textarea,button{box-sizing:border-box}button:after{border:none}.page-shell{min-height:100vh;background:#f5f5f5;padding-bottom:28rpx}.panel{margin:20rpx 24rpx;padding:28rpx;background:#fff;border-radius:12rpx}.section-title{font-size:32rpx;font-weight:600;color:#1f2329}.muted{color:#8f959e}.primary-btn{height:88rpx;line-height:88rpx;background:#0052d9;color:#fff;border-radius:8rpx;font-size:30rpx}.outline-btn{height:80rpx;line-height:80rpx;background:#fff;color:#0052d9;border:1px solid #0052d9;border-radius:8rpx;font-size:28rpx}.empty-state{padding:120rpx 32rpx;text-align:center;color:#8f959e}.empty-state text{display:block;margin-top:18rpx}.form-row{margin-bottom:28rpx}.form-label{display:block;margin-bottom:14rpx;color:#4e5969}.form-input{width:100%;height:84rpx;padding:0 24rpx;background:#f7f8fa;border:1px solid #e5e6eb;border-radius:8rpx}.status-blue{color:#0052d9}.status-green{color:#00a870}.status-orange{color:#ed7b2f}.price{color:#d54941;font-weight:600}
page{--status-bar-height:25px;--top-window-height:0px;--window-top:0px;--window-bottom:0px;--window-left:0px;--window-right:0px;--window-magin:0px}[data-c-h="true"]{display: none !important;}