<view class="page-shell service-page data-v-2ffa0e8e"><view class="search-bar data-v-2ffa0e8e"><input class="data-v-2ffa0e8e" confirm-type="search" placeholder="请输入服务名称关键字" bindconfirm="{{a}}" value="{{b}}" bindinput="{{c}}"/><text class="data-v-2ffa0e8e" bindtap="{{d}}">搜索</text></view><view wx:if="{{e}}" class="empty-state data-v-2ffa0e8e"><text class="data-v-2ffa0e8e">暂无可选服务</text></view><view class="service-grid data-v-2ffa0e8e"><view wx:for="{{f}}" wx:for-item="item" wx:key="f" class="service-card data-v-2ffa0e8e" bindtap="{{item.g}}"><view class="{{['service-image', 'data-v-2ffa0e8e', item.a]}}"><image class="data-v-2ffa0e8e" src="{{g}}" mode="aspectFit"/></view><text class="service-name data-v-2ffa0e8e">{{item.b}}</text><text class="service-desc data-v-2ffa0e8e">{{item.c}}</text><view class="service-bottom data-v-2ffa0e8e"><text class="price data-v-2ffa0e8e">¥{{item.d}}</text><text class="unit data-v-2ffa0e8e">/{{item.e}}</text></view></view></view></view>